{
  "name": "token-effort",
  "owner": { "name": "HeadlessTarry" },
  "metadata": { "description": "Token-Effort core plugin and overhaul mods for Claude Code" },
  "plugins": [
    {
      "name": "token-effort",
      "source": "./",
      "description": "Token-Effort core plugin: home-grown skills, working conventions injected into every session and subagent, the Port and SonarQube Cloud MCP servers, and /token-effort:setup to merge starter settings",
      "author": { "name": "HeadlessTarry" },
      "skills": ["./skills/", "./plugins/claude/token-effort/skills/"],
      "userConfig": {
        "sonarqube_token": {
          "type": "string",
          "title": "SonarQube Cloud user token",
          "description": "Personal access token from My account > Access Tokens in SonarQube Cloud",
          "sensitive": true
        },
        "sonarqube_org": {
          "type": "string",
          "title": "SonarQube Cloud organization key",
          "description": "Organization key, for example headlesstarry",
          "default": "headlesstarry"
        }
      },
      "mcpServers": {
        "port-eu": {
          "type": "http",
          "url": "https://mcp.port.io/v1",
          "headers": { "x-read-only-mode": "0" }
        },
        "sonarqube": {
          "type": "http",
          "url": "https://api.sonarcloud.io/mcp",
          "headers": {
            "Authorization": "Bearer ${user_config.sonarqube_token}",
            "SONARQUBE_ORG": "${user_config.sonarqube_org}",
            "SONARQUBE_READ_ONLY": "true"
          }
        }
      },
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node",
                "args": ["${CLAUDE_PLUGIN_ROOT}/plugins/claude/token-effort/scripts/inject-conventions.js", "SessionStart"],
                "timeout": 10
              }
            ]
          }
        ],
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node",
                "args": ["${CLAUDE_PLUGIN_ROOT}/plugins/claude/token-effort/scripts/session-title.js"],
                "timeout": 15
              }
            ]
          }
        ],
        "SubagentStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node",
                "args": ["${CLAUDE_PLUGIN_ROOT}/plugins/claude/token-effort/scripts/inject-conventions.js", "SubagentStart"],
                "timeout": 10
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "matcher": "^(Bash|PowerShell)$",
            "hooks": [
              {
                "type": "command",
                "command": "node",
                "args": ["${CLAUDE_PLUGIN_ROOT}/plugins/claude/token-effort/skills/shepherding-pr-reviews/scripts/review-state.js", "hook-post-create"],
                "timeout": 15
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node",
                "args": ["${CLAUDE_PLUGIN_ROOT}/plugins/claude/token-effort/skills/shepherding-pr-reviews/scripts/review-state.js", "hook-stop"],
                "timeout": 30
              }
            ]
          }
        ]
      }
    },
    {
      "name": "under-empire",
      "source": "./plugins/claude/overhaul-mods/under-empire",
      "description": "Under-Empire overhaul mod: a scheming Skaven Warlock Engineer voice for prose, with plain professional artefacts, an Underlings pane of running subagents and background tasks, and a Doomwheel pane of each PR's review process"
    }
  ]
}
